# StockAI — deployment env for docker compose (VM / local).
# Copy to /app/.env  (same folder as docker-compose.yml):  cp deploy.env.example .env
# docker compose reads THIS file automatically for ${VAR} substitution.
# NEVER commit the filled-in .env (it holds secrets).

# ---- Postgres password (used by both the postgres service and the backend) ----
POSTGRES_PASSWORD=change_me_strong_password

# ---- Which providers to use ----
# market/portfolio: mock | zerodha
DATA_PROVIDER=zerodha
# fundamentals/news: mock | yfinance   (yfinance = Yahoo Finance, no key needed)
FUNDAMENTAL_PROVIDER=yfinance
NEWS_PROVIDER=yfinance
# AI primary: mock | openai | gemini    fallback tried when primary fails
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
AI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Secrets (server-side only; leave blank the ones you don't use) ----
OPENAI_API_KEY=sk-...your-openai-key...
GEMINI_API_KEY=AQ....your-gemini-key...
ZERODHA_API_KEY=your_kite_api_key
ZERODHA_API_SECRET=your_kite_api_secret
# Leave ACCESS_TOKEN blank — it is minted daily via the in-app Kite login flow.
ZERODHA_ACCESS_TOKEN=

# ---- Public URL the browser uses to reach the backend (BAKED into frontend build) ----
# On a GCE VM this is  http://<VM_EXTERNAL_IP>:8001
REACT_APP_BACKEND_URL=http://REPLACE_WITH_VM_EXTERNAL_IP:8001
